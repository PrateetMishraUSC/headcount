# Copy to .env and adjust. Real environment variables take precedence over .env.
DATABASE_URL=postgresql://localhost:5432/headcount_dev
TEST_DATABASE_URL=postgresql://localhost:5432/headcount_test

# Signs the sign-in cookie (required by the web app). Use a long random value, the same on
# every web server; changing it signs everyone out. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# SECRET_KEY=   (required: add your own line, see the README quick start)

# Optional tuning (defaults shown)
# STATEMENT_TIMEOUT_MS=5000        # per web request; slower queries return 504
# DB_CONNECT_TIMEOUT_S=5           # give up connecting to Postgres after this long
# WORKER_POLL_INTERVAL_S=1         # how often the worker looks for free seats
# WORKER_RECONNECT_EVERY=360       # worker opens a fresh connection every N polls
# DISPLAY_TIMEZONE=America/Los_Angeles  # time zone pages show event times in
